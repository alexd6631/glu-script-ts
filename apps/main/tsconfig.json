{
  "compilerOptions": {
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "allowArbitraryExtensions": true,
    "declaration": true,
    "declarationMap": true,
    "lib": ["es2023"],
    "types": ["node", "vitest/globals"],
    "module": "NodeNext",
    "outDir": "./dist",
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true,
    "target": "es2022",
    "skipLibCheck": true,
    "rootDir": "./src"
  },
  "include": ["./src"]
}
